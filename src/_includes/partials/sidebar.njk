<div class="card">
  <h2 class="card-title">Slusstelefon</h2>
  <p class="phone"><a href="tel:{{ site.telephoneLink }}">{{ site.telephone }}</a></p>
</div>

<div class="card">
  <h2 class="card-title">Sicklaslussens vänner</h2>
  <ul class="sponsor-list">
    {% for sponsor in site.sponsors %}
    <li>
      {% if sponsor.url %}<a href="{{ sponsor.url }}" target="_blank" rel="noopener">{% endif %}
        <img src="{{ sponsor.image | url }}" alt="{{ sponsor.name }}">
      {% if sponsor.url %}</a>{% endif %}
    </li>
    {% endfor %}
  </ul>
  <p><a class="text-link" href="{{ '/vanner/' | url }}">Läs mer om att bli vän</a></p>
</div>